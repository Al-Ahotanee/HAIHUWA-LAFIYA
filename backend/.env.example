# Runtime
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-pooler.us-east-2.aws.neon.tech:5432/neondb?ssl=require
DATABASE_URL_DIRECT=postgresql+asyncpg://user:password@ep-example.us-east-2.aws.neon.tech:5432/neondb?ssl=require
SECRET_KEY=change-me-to-a-random-64-char-string
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Rate Limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Integrations (optional)
SMS_PROVIDER=console
# SMS_API_KEY=
# SMS_SENDER_ID=

PAYMENT_PROVIDER=manual
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
